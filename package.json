{
  "name": "@meucalendario/calendar",
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "packageManager": "yarn@1.22.22",
  "scripts": {
    "build": "node scripts/build-package.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "node scripts/typecheck.mjs",
    "dev": "vite --host 127.0.0.1 --open /examples/react.html",
    "test:package": "node scripts/package-smoke.mjs",
    "build:demo": "vite build",
    "test:browser": "node scripts/run-browser-review.mjs",
    "audit:dependencies": "node scripts/audit-dependencies.mjs",
    "verify": "yarn typecheck && yarn test && yarn build && yarn test:package && yarn build:demo"
  },
  "devDependencies": {
    "@playwright/cli": "0.1.22",
    "@testing-library/dom": "10.4.0",
    "@testing-library/react": "16.1.0",
    "@types/react": "19.1.0",
    "@types/react-dom": "19.1.0",
    "ical.js": "^2.2.1",
    "jsdom": "24.1.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "rrule": "2.8.1",
    "typescript": "5.5.4",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  },
  "license": "UNLICENSED",
  "description": "Calendário React nativo com recursos, recorrência, constraints e views personalizáveis.",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./core": {
      "types": "./dist/esm/core/index.d.ts",
      "import": "./dist/esm/core/index.js",
      "require": "./dist/cjs/core/index.js"
    },
    "./styles.css": "./styles.css"
  },
  "files": [
    "dist/esm",
    "dist/cjs",
    "styles.css"
  ],
  "sideEffects": [
    "./styles.css"
  ],
  "dependencies": {
    "@floating-ui/react": "^0.27.20",
    "@js-temporal/polyfill": "0.4.4",
    "rrule-temporal": "2.2.8"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  }
}
