{
  "name": "meucalendario-monorepo",
  "version": "0.0.0",
  "private": true,
  "packageManager": "yarn@1.22.22",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "yarn workspace @meucalendario/core run build && yarn workspace @meucalendario/react run build && yarn workspace @meucalendario/styles run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "yarn workspaces run typecheck"
  },
  "devDependencies": {
    "@js-temporal/polyfill": "0.4.4",
    "@testing-library/dom": "10.4.0",
    "@testing-library/react": "16.1.0",
    "@types/react": "19.1.0",
    "@types/react-dom": "19.1.0",
    "jsdom": "24.1.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "rrule": "2.8.1",
    "typescript": "5.5.4",
    "vitest": "2.0.5"
  },
  "license": "UNLICENSED"
}
