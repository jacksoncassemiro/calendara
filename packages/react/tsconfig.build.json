  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "declarationMap": false,
    "sourceMap": false,
    "outDir": "./dist/esm",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "baseUrl": ".",
