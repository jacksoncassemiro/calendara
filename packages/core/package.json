{
  "name": "@meucalendario/core",
  "version": "0.0.0",
  "description": "Núcleo headless (TS puro) da biblioteca de calendário: tipos canônicos, DateUtils (Temporal), motor de recorrência RFC 5545 e ConstraintEngine.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc -p tsconfig.cjs.json && node -e \"require('fs').writeFileSync('dist/cjs/package.json', '{\\\"type\\\":\\\"commonjs\\\"}')\"",
    "typecheck": "tsc --noEmit"
  },
  "publishConfig": {
    "main": "./dist/cjs/index.js",
    "module": "./dist/esm/index.js",
    "types": "./dist/esm/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/esm/index.d.ts",
        "import": "./dist/esm/index.js",
        "require": "./dist/cjs/index.js"
      }
    }
  },
  "dependencies": {
    "preact": "^10.23.2"
  },
  "peerDependencies": {
    "@js-temporal/polyfill": "^0.4.4"
  },
  "peerDependenciesMeta": {
    "@js-temporal/polyfill": {
      "optional": true
    }
  },
  "license": "UNLICENSED"
}
